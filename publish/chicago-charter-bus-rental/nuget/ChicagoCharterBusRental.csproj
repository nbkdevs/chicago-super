<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>ChicagoCharterBusRental</PackageId>
    <Version>1.0.0</Version>
    <Authors>nbkdevs</Authors>
    <Description>Chicago group charter planner: recommends the fewest vehicles for a headcount from the Chicago Charter Bus Rental fleet seat sizes, with spare-seat counts and a late-additions buffer.</Description>
    <PackageTags>chicago;charter;bus;group-travel;planner;calculator</PackageTags>
    <RepositoryUrl>https://github.com/nbkdevs/chicago-super</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://chicagosupercoachbus.com/</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="bin/**;obj/**" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
