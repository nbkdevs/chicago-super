{
  "manifest_version": 3,
  "name": "Travel Pal — Journey Notes",
  "version": "1.0.0",
  "description": "A lightweight companion for jotting trip memories and travel notes while you browse.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Travel Pal"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [],
  "browser_specific_settings": {
    "gecko": {
      "id": "travel-pal@travelpal.app",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
